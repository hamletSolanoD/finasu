# Credenciales de Anthropic (nunca subir el .env real a git)
ANTHROPIC_API_KEY=

# Routing de modelos — cambia estos valores para actualizar de modelo sin tocar código.
# Los valores de abajo son los defaults si no se definen estas variables.
MODEL_ROUTER_FAST_MODEL=claude-haiku-4-5
MODEL_ROUTER_ESCALATION_MODEL=claude-sonnet-5
# alto | medio | bajo — confianza mínima aceptable antes de escalar a MODEL_ROUTER_ESCALATION_MODEL
MODEL_ROUTER_MIN_CONFIDENCE=alto
